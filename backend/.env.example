# ─────────────────────────────────────────────────────────────
# Solution One ESS — Backend environment template
# Copy this file to ".env" on the server and fill in real values.
# The .env file itself is gitignored (never commit secrets).
# ─────────────────────────────────────────────────────────────

# SQL Server connection.
# When the API runs ON the DB/vendor server, use localhost — the API
# reaches SQL Server over the internal TCP port, exactly like the web app.
DB_HOST=localhost
DB_PORT=1433
DB_USER=your_sql_login
DB_PASSWORD=your_sql_password
DB_NAME=SolutionOne_HR

# API server
PORT=3000

# Auth — generate a strong random value (do NOT reuse the placeholder)
JWT_SECRET=change-me-to-a-long-random-secret
